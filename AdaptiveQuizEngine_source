        // --- Module 3 Demo: Recursion & Arrays ---
        System.out.println("--- [Module 3] Recursion & Matrix Arithmetic ---");
        int factNum = 5;
        System.out.println("Factorial of " + factNum + " (Recursive): " + recursiveFactorial(factNum));
        
        int[][] matrixA = {{1, 2}, {3, 4}};
        int[][] matrixB = {{5, 6}, {7, 8}};
        int[][] matrixSum = addMatrices(matrixA, matrixB);
        System.out.println("2D Matrix Addition Result row 0: [" + matrixSum[0][0] + ", " + matrixSum[0][1] + "]\n");

