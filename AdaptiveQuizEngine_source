        } catch (ArithmeticException e) {
            System.out.println("Caught Expected Exception: " + e.getMessage());
        } finally {
            System.out.println("Exception handling flow completed successfully.\n");
        }

        // --- Module 5 Demo: Strings & Algorithms ---
        System.out.println("--- [Module 5] Strings & Sorting Algorithms ---");
        StringBuilder sb = new StringBuilder("Java");
        sb.append(" Engine").insert(4, " Core");
