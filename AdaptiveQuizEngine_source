import java.util.*;
import java.util.stream.Collectors;
class AdaptiveQuizPlatform {

    // ==========================================
    // 1. ENGINE ENTITY & ADAPTIVE LOGIC
    // ==========================================
    public static class Question {
        private String id;
        private int moduleNumber;
        private int difficultyLevel; // 1: Easy, 2: Medium, 3: Hard
        private String prompt;
        private String[] options;
        private int correctIndex;
        private String explanation;

        public Question(String id, int moduleNumber, int difficultyLevel, String prompt, String[] options, int correctIndex, String explanation) {
            this.id = id;
            this.moduleNumber = moduleNumber;
            this.difficultyLevel = difficultyLevel;
            this.prompt = prompt;
            this.options = options;
            this.correctIndex = correctIndex;
            this.explanation = explanation;
        }

        public boolean validateAnswer(int selectedIndex) {
            return this.correctIndex == selectedIndex;
        }

        public int getModuleNumber() { return moduleNumber; }
        public int getDifficultyLevel() { return difficultyLevel; }
        public String getPrompt() { return prompt; }
        public String[] getOptions() { return options; }
        public String getExplanation() { return explanation; }
    }

    public static class AdaptiveQuizEngine {
        private List<Question> questionBank;
        private int currentDifficulty = 1; // Starts at Easy
        private int consecutiveCorrect = 0;
        private int consecutiveWrong = 0;
        private Set<String> askedQuestionIds = new HashSet<>();

        public AdaptiveQuizEngine(List<Question> questionBank) {
            this.questionBank = questionBank;
        }

        public Question getNextQuestion(int moduleNumber) {
            List<Question> eligible = questionBank.stream()
                .filter(q -> q.getModuleNumber() == moduleNumber)
                .filter(q -> q.getDifficultyLevel() == currentDifficulty)
                .filter(q -> !askedQuestionIds.contains(q.getPrompt()))
                .collect(Collectors.toList());

            // Fallback if current difficulty pool is exhausted
            if (eligible.isEmpty()) {
                eligible = questionBank.stream()
                    .filter(q -> q.getModuleNumber() == moduleNumber)
                    .filter(q -> !askedQuestionIds.contains(q.getPrompt()))
                    .collect(Collectors.toList());
            }

            if (eligible.isEmpty()) return null;

            Random rand = new Random();
            Question selected = eligible.get(rand.nextInt(eligible.size()));
            askedQuestionIds.add(selected.getPrompt());
            return selected;
        }

        public void recordResponse(boolean isCorrect) {
            if (isCorrect) {
                consecutiveCorrect++;
                consecutiveWrong = 0;
                if (consecutiveCorrect >= 2 && currentDifficulty < 3) {
                    currentDifficulty++; // Step up difficulty
                    consecutiveCorrect = 0;
                }
            } else {
                consecutiveWrong++;
                consecutiveCorrect = 0;
                if (consecutiveWrong >= 1 && currentDifficulty > 1) {
                    currentDifficulty--; // Step down difficulty
                    consecutiveWrong = 0;
                }
            }
        }
        
        public int getCurrentDifficulty() {
            return currentDifficulty;
        }
    }

    // ==========================================
    // 2. MODULE DEMONSTRATIONS & HELPERS
    // ==========================================
    
    // Interface for Module 4 OOP Demonstration
    interface Renderable {
        void render();
    }

    public static class Shape implements Renderable {
        private String name;
        public Shape(String name) { this.name = name; }
        @Override
        public void render() { System.out.println("Rendering shape: " + name); }
    }

    // Helper for Module 3 Recursion
    private static int recursiveFactorial(int n) {
        if (n <= 1) return 1; // Base case
        return n * recursiveFactorial(n - 1); // Recursive case
    }

    // Helper for Module 3 Matrix Addition
    private static int[][] addMatrices(int[][] a, int[][] b) {
        int rows = a.length;
        int cols = a[0].length;
        int[][] res = new int[rows][cols];
        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                res[i][j] = a[i][j] + b[i][j];
            }
        }
        return res;
    }

    // Sample question bank generator for engine simulation
    private static List<Question> createSampleQuestionBank() {
        List<Question> bank = new ArrayList<>();
        // Module 1 Questions
        bank.add(new Question("m1_e1", 1, 1, "What is the default value of an uninitialized int field in Java?", new String[]{"0", "null", "1", "Undefined"}, 0, "Primitive int defaults to 0."));
        bank.add(new Question("m1_m1", 1, 2, "Which operator has the highest precedence among arithmetic operators?", new String[]{"Addition", "Multiplication/Division", "Assignment", "Subtraction"}, 1, "Multiplication and division take precedence over addition and subtraction."));
        bank.add(new Question("m1_h1", 1, 3, "What is the precise output of (double) 5 / 2 in Java?", new String[]{"2.0", "2.5", "2", "Compilation Error"}, 1, "Casting 5 to double forces floating-point division yielding 2.5."));
        return bank;
    }

    // ==========================================
    // 3. MAIN EXECUTION DRIVER
    // ==========================================
    public static void main(String[] args) {
        System.out.println("==================================================");
        System.out.println("  ADAPTIVE QUIZ & EXAM ENGINE - UNIFIED CO DEMO");
        System.out.println("==================================================\n");

        // --- Module 1 Demo: Foundations & Typecasting ---
        System.out.println("--- [Module 1] Foundations & Typecasting ---");
