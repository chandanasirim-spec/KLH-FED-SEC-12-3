
import java.util.*;
import java.util.stream.Collectors;

class AdaptiveExamPlatform {

    // ==========================================
    // 1. DATA MODELS & ANALYTICS ENTITIES
    // ==========================================
    public static class Question {
        private String id;
        private int moduleNumber;
        private int difficultyLevel; // 1: Easy, 2: Medium, 3: Hard
        private String prompt;
        private String[] options;
        private int correctIndex;
        private String explanation;

        public Question(String id, int moduleNumber, int difficultyLevel, String prompt, String[] options, int correctIndex, String explanation) {
            this.id = id;
            this.moduleNumber = moduleNumber;
            this.difficultyLevel = difficultyLevel;
            this.prompt = prompt;
            this.options = options;
            this.correctIndex = correctIndex;
            this.explanation = explanation;
        }

        public boolean validateAnswer(int selectedIndex) {
            return this.correctIndex == selectedIndex;
        }

        public int getModuleNumber() { return moduleNumber; }
        public int getDifficultyLevel() { return difficultyLevel; }
        public String getPrompt() { return prompt; }
        public String[] getOptions() { return options; }
        public String getExplanation() { return explanation; }
        public String getId() { return id; }
    }

    public static class QuizSessionRecord {
        private int moduleNumber;
        private int attempted;
        private int correct;
        private double accuracy;
        private String timestamp;

        public QuizSessionRecord(int moduleNumber, int attempted, int correct) {
            this.moduleNumber = moduleNumber;
            this.attempted = attempted;
            this.correct = correct;
            this.accuracy = attempted > 0 ? ((double) correct / attempted) * 100 : 0.0;
            this.timestamp = new Date().toString();
        }

        @Override
        public String toString() {
            return String.format("[Module %d] Attempted: %d | Correct: %d | Accuracy: %.2f%% | Time: %s",
                    moduleNumber, attempted, correct, accuracy, timestamp);
        }
    }

    // Global system records for Admin tracking
    private static List<QuizSessionRecord> globalHistory = new ArrayList<>();
    private static int totalSystemAttempts = 0;
    private static int totalSystemCorrect = 0;

    // ==========================================
    // 2. QUESTION BANK (Modules 1-6 across 3 Levels)
    // ==========================================
    private static List<Question> initializeQuestionBank() {
        List<Question> bank = new ArrayList<>();

        // --- Module 1: Foundations ---
        bank.add(new Question("m1_1", 1, 1, "What is the default value of an uninitialized primitive int field in Java?", new String[]{"0", "null", "1", "Undefined"}, 0, "Primitive int fields default to 0."));
        bank.add(new Question("m1_2", 1, 2, "Which operator has the highest precedence among arithmetic operators?", new String[]{"Addition (+)", "Multiplication (*)", "Assignment (=)", "Subtraction (-)"}, 1, "Multiplication and division take precedence."));
        bank.add(new Question("m1_3", 1, 3, "What is the precise output of: double val = (double) 5 / 2;", new String[]{"2.0", "2.5", "2", "Compilation Error"}, 1, "Casting 5 to double forces floating-point division yielding 2.5."));

        // --- Module 2: Control Flow ---
        bank.add(new Question("m2_1", 2, 1, "Which keyword is used to terminate a switch case?", new String[]{"stop", "break", "exit", "continue"}, 1, "The 'break' keyword exits the switch statement."));
        bank.add(new Question("m2_2", 2, 2, "How many times does a do-while loop execute its block at minimum?", new String[]{"0 times", "1 time", "Infinite times", "Depends on condition"}, 1, "A do-while loop guarantees at least one execution."));
        bank.add(new Question("m2_3", 2, 3, "What happens if a loop condition evaluates to true indefinitely?", new String[]{"StackOverflowError", "Infinite Loop", "Compilation Error", "Automatic Break"}, 1, "It creates an infinite loop consuming CPU cycles."));

        // --- Module 3: Methods, Recursion & Arrays ---
        bank.add(new Question("m3_1", 3, 1, "What is mandatory in a recursive method to prevent stack overflow?", new String[]{"A loop", "A base case", "An array", "Static modifier"}, 1, "A base case stops the recursive calls."));
        bank.add(new Question("m3_2", 3, 2, "What does Arrays.binarySearch() require on a 1D array before execution?", new String[]{"The array must be sorted", "Only positive values", "Be empty", "No requirement"}, 0, "Binary search requires a sorted array."));
        bank.add(new Question("m3_3", 3, 3, "In a 2D matrix array, what represents the number of rows?", new String[]{"matrix[0].length", "matrix.length", "matrix.cols", "matrix.size()"}, 1, "matrix.length gives the total number of rows."));

        // --- Module 4: OOP & Exceptions ---
        bank.add(new Question("m4_1", 4, 1, "Which keyword establishes inheritance between a subclass and superclass?", new String[]{"implements", "extends", "inherits", "super"}, 1, "The 'extends' keyword is used for class inheritance."));
        bank.add(new Question("m4_2", 4, 2, "Which type of exception must be explicitly caught or declared using throws?", new String[]{"RuntimeException", "Checked Exception", "Error", "ArithmeticException"}, 1, "Checked exceptions are verified at compile-time."));
        bank.add(new Question("m4_3", 4, 3, "Which block always executes regardless of whether an exception occurred?", new String[]{"try", "catch", "finally", "throw"}, 2, "The 'finally' block ensures execution for clean-up tasks."));

        // --- Module 5: Strings & File I/O ---
        bank.add(new Question("m5_1", 5, 1, "Are String objects in Java mutable or immutable?", new String[]{"Mutable", "Immutable", "Depends on declaration", "Thread-safe mutable"}, 1, "Strings in Java are immutable."));
        bank.add(new Question("m5_2", 5, 2, "What does the equals() method compare in Java Strings?", new String[]{"Memory reference location", "Actual character sequence (value)", "Object hashcode", "Length only"}, 1, "equals() compares value content."));
        bank.add(new Question("m5_3", 5, 3, "Which modern Java NIO API is recommended for reading text files line-by-line efficiently?", new String[]{"FileInputStream", "Files.readAllLines(Path)", "Scanner only", "BufferedRandomAccess"}, 1, "Files.readAllLines or BufferedReader via NIO Path provides efficient reading."));

        // --- Module 6: Collections & Streams ---
        bank.add(new Question("m6_1", 6, 1, "Which Collection interface represents an ordered sequence allowing duplicates?", new String[]{"Set", "Map", "List", "Queue"}, 2, "List maintains order and permits duplicates."));
        bank.add(new Question("m6_2", 6, 2, "In Java Stream API, is filter() an intermediate or terminal operation?", new String[]{"Terminal operation", "Intermediate operation", "Independent action", "Collection method"}, 1, "filter() returns a new Stream (intermediate operation)."));
        bank.add(new Question("m6_3", 6, 3, "Which functional interface accepts an input argument and returns no result?", new String[]{"Predicate<T>", "Function<T, R>", "Consumer<T>", "Supplier<T>"}, 2, "Consumer accepts an argument and performs an action without returning a value."));

        return bank;
    }

    // ==========================================
    // 3. ADAPTIVE QUIZ ENGINE CONTROLLER
    // ==========================================
    private static void runPlayerQuizSession(Scanner scanner, List<Question> bank) {
        System.out.println("\n--- Select Module to Play (1 to 6) ---");
        System.out.println("1. Module 1: Foundations & Typecasting");
        System.out.println("2. Module 2: Control Flow");
        System.out.println("3. Module 3: Methods, Recursion & Arrays");
        System.out.println("4. Module 4: OOP & Exception Handling");
        System.out.println("5. Module 5: Strings & File I/O");
        System.out.println("6. Module 6: Collections & Streams");
        System.out.print("Enter module number: ");

        if (!scanner.hasNextInt()) {
            System.out.println("Invalid input.");
            scanner.next();
            return;
        }

        int modNum = scanner.nextInt();
        if (modNum < 1 || modNum > 6) {
            System.out.println("Invalid module selection.");
            return;
        }

        int currentDifficulty = 1; // Start at Easy
        int consecutiveCorrect = 0;
        int consecutiveWrong = 0;
        Set<String> askedIds = new HashSet<>();
        int attempted = 0;
        int correct = 0;

        System.out.println("\n[Quiz Started] Difficulty adapts dynamically based on your answers!");

        while (true) {
            List<Question> eligible = bank.stream()
                .filter(q -> q.getModuleNumber() == modNum)
                .filter(q -> q.getDifficultyLevel() == currentDifficulty)
                .filter(q -> !askedIds.contains(q.getId()))
                .collect(Collectors.toList());

            if (eligible.isEmpty()) {
                // Fallback to any remaining questions in module
                eligible = bank.stream()
                    .filter(q -> q.getModuleNumber() == modNum)
                    .filter(q -> !askedIds.contains(q.getId()))
                    .collect(Collectors.toList());
            }

            if (eligible.isEmpty()) {
                System.out.println("\n[!] You have exhausted all questions for Module " + modNum + "!");
                break;
            }

            Random rand = new Random();
            Question q = eligible.get(rand.nextInt(eligible.size()));
            askedIds.add(q.getId());

            System.out.println("\n--------------------------------------------------");
            System.out.println("[Difficulty Level: " + q.getDifficultyLevel() + " / 3]");
            System.out.println("Q: " + q.getPrompt());
            String[] opts = q.getOptions();
            for (int i = 0; i < opts.length; i++) {
                System.out.println("  [" + i + "] " + opts[i]);
            }

            System.out.print("Enter your option number (0-" + (opts.length - 1) + ") or -1 to quit quiz: ");
            if (!scanner.hasNextInt()) {
                System.out.println("Invalid input format.");
                scanner.next();
                continue;
            }

            int ans = scanner.nextInt();
            if (ans == -1) break;
            if (ans < 0 || ans >= opts.length) {
                System.out.println("Invalid option index. Try again.");
                continue;
            }

            attempted++;
            totalSystemAttempts++;

            boolean isCorrect = q.validateAnswer(ans);
            if (isCorrect) {
                correct++;
                totalSystemCorrect++;
                consecutiveCorrect++;
                consecutiveWrong = 0;
                System.out.println("--> CORRECT! " + q.getExplanation());
                if (consecutiveCorrect >= 2 && currentDifficulty < 3) {
                    currentDifficulty++;
                    consecutiveCorrect = 0;
                    System.out.println(">>> Difficulty Increased to Level " + currentDifficulty + "!");
                }
            } else {
                consecutiveWrong++;
                consecutiveCorrect = 0;
                System.out.println("--> INCORRECT. " + q.getExplanation());
                if (consecutiveWrong >= 1 && currentDifficulty > 1) {
                    currentDifficulty--;
                    consecutiveWrong = 0;
                    System.out.println(">>> Difficulty Decreased to Level " + currentDifficulty + ".");
                }
            }

            System.out.print("Continue to next question? (y/n): ");
            char cont = scanner.next().charAt(0);
            if (cont == 'n' || cont == 'N') break;
        }

        // Save session record
        if (attempted > 0) {
            QuizSessionRecord record = new QuizSessionRecord(modNum, attempted, correct);
            globalHistory.add(record);
            System.out.println("\n--- Quiz Finished ---");
            System.out.println(record);
        }
    }

    // ==========================================
    // 4. MAIN DASHBOARD DRIVER
    // ==========================================
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        List<Question> questionBank = initializeQuestionBank();

        boolean running = true;
        while (running) {
            System.out.println("\n==================================================");
            System.out.println("   ADAPTIVE QUIZ & EXAM ENGINE - MAIN DASHBOARD   ");
            System.out.println("==================================================");
            System.out.println("1. Player Portal");
            System.out.println("2. Admin Portal");
            System.out.println("3. Exit Application");
            System.out.print("Select portal (1-3): ");

            if (!scanner.hasNextInt()) {
                System.out.println("Invalid input. Please enter 1, 2, or 3.");
                scanner.next();
                continue;
            }

            int portalChoice = scanner.nextInt();

            switch (portalChoice) {
                case 1: // Player Portal
                    boolean playerActive = true;
                    while (playerActive) {
                        System.out.println("\n--------------------------------------------------");
                        System.out.println("                   PLAYER PORTAL                  ");
                        System.out.println("--------------------------------------------------");
                        System.out.println("1. Play Quiz");
                        System.out.println("2. View Past Participations");
                        System.out.println("3. Back to Main Menu");
                        System.out.print("Choose option (1-3): ");

                        if (!scanner.hasNextInt()) {
                            System.out.println("Invalid input.");
                            scanner.next();
                            continue;
                        }

                        int pChoice = scanner.nextInt();
                        switch (pChoice) {
                            case 1:
                                runPlayerQuizSession(scanner, questionBank);
                                break;
                            case 2:
                                System.out.println("\n--- Past Participations History ---");
                                if (globalHistory.isEmpty()) {
                                    System.out.println("No quiz participations recorded yet.");
                                } else {
                                    for (int i = 0; i < globalHistory.size(); i++) {
                                        System.out.println((i + 1) + ". " + globalHistory.get(i));
                                    }
                                }
                                break;
                            case 3:
                                playerActive = false;
                                break;
                            default:
                                System.out.println("Invalid option. Choose 1, 2, or 3.");
                        }
                    }
                    break;

                case 2: // Admin Portal
                    boolean adminActive = true;
                    while (adminActive) {
                        System.out.println("\n--------------------------------------------------");
                        System.out.println("                   ADMIN PORTAL                   ");
                        System.out.println("--------------------------------------------------");
                        System.out.println("1. Check Questions (Question Bank)");
                        System.out.println("2. Check Overall Attempts & Statistics");
                        System.out.println("3. Back to Main Menu");
                        System.out.print("Choose option (1-3): ");

                        if (!scanner.hasNextInt()) {
                            System.out.println("Invalid input.");
                            scanner.next();
                            continue;
                        }

                        int aChoice = scanner.nextInt();
                        switch (aChoice) {
                            case 1:
                                System.out.println("\n--- Question Bank Registry ---");
                                System.out.println("Total Loaded Questions: " + questionBank.size());
                                for (Question q : questionBank) {
                                    System.out.printf("[Mod %d | Diff %d] %s (Options: %d)%n",
                                            q.getModuleNumber(), q.getDifficultyLevel(), q.getPrompt(), q.getOptions().length);
                                }
                                break;
                            case 2:
                                System.out.println("\n--- Overall System Attempts & Analytics ---");
                                System.out.println("Total System Attempts across all sessions: " + totalSystemAttempts);
                                System.out.println("Total Correct Answers: " + totalSystemCorrect);
                                if (totalSystemAttempts > 0) {
                                    double overallAcc = ((double) totalSystemCorrect / totalSystemAttempts) * 100;
                                    System.out.printf("Overall System Accuracy: %.2f%%%n", overallAcc);
                                }
                                System.out.println("Total Completed Quiz Sessions: " + globalHistory.size());
                                break;
                            case 3:
                                adminActive = false;
                                break;
                            default:
                                System.out.println("Invalid option. Choose 1, 2, or 3.");
                        }
                    }
                    break;

                case 3:
                    running = false;
                    System.out.println("Exiting Adaptive Quiz Engine. Goodbye!");
                    break;

                default:
                    System.out.println("Invalid selection. Choose 1, 2, or 3.");
            }
        }
        scanner.close();
    }
}

