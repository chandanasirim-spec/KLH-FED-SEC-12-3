        System.out.println("Sorted Array: " + Arrays.toString(numbers) + " | Index of 23: " + searchIdx + "\n");

        // --- Module 6 Demo: Functional Programming & Streams ---
        System.out.println("--- [Module 6] Functional Programming & Streams ---");
        List<String> modules = Arrays.asList("Foundations", "Control Flow", "Methods & Arrays", "OOP", "Strings & Files", "Streams");
        List<String> processedModules = modules.stream()
            .filter(m -> m.length() > 5)
            .map(String::toUpperCase)
            .sorted()
            .collect(Collectors.toList());
        System.out.println("Filtered & Sorted Modules: " + processedModules + "\n");

        // --- Running the Adaptive Quiz Engine ---
        System.out.println("--- [Engine Simulation] Adaptive Quiz Session ---");
        List<Question> bank = createSampleQuestionBank();
        AdaptiveQuizEngine engine = new AdaptiveQuizEngine(bank);

        int targetModule = 1;
        for (int step = 1; step <= 3; step++) {
            Question q = engine.getNextQuestion(targetModule);
            if (q == null) break;
            
            System.out.println("\n[Question " + step + "] (Difficulty Level: " + q.getDifficultyLevel() + ")");
            System.out.println("Prompt: " + q.getPrompt());
            
            // Simulating correct answers to test dynamic difficulty step-up
            boolean isCorrect = true; 
            System.out.println("Simulated Student Answer: Correct -> " + isCorrect);
            engine.recordResponse(isCorrect);
            System.out.println("Updated Engine Difficulty Level: " + engine.getCurrentDifficulty());
        }
        
        System.out.println("\n==================================================");
        System.out.println("  ALL MODULES EXECUTED SUCCESSFULLY");
        System.out.println("==================================================");
    }
}

